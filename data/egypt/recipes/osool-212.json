{"recipe":{"id":"osool-212","title":"الدجاج المسبك بالبطاطس الصغيرة","titleEn":"Braised Chicken with New Potatoes","category":"لحوم وطيور","cookingMethod":"تسبيك","prepTime":"20 دقيقة","cookTime":"1 ساعة ونصف","servings":"4 أفراد","masterIngredients":[{"name":"دجاجة بلدية","nameEn":null,"standardAmount":"1 دجاجة"},{"name":"سمن","nameEn":null,"standardAmount":"1 ملعقة كبيرة"},{"name":"بصلة وجزرة (تقطع حلقات)","nameEn":null,"standardAmount":"1 من كل"},{"name":"قطعة كرفس","nameEn":null,"standardAmount":"1 قطعة"},{"name":"بطاطس صغيرة مستديرة","nameEn":null,"standardAmount":"نصف كيلو"},{"name":"ماء","nameEn":null,"standardAmount":"1 لتر"},{"name":"حبهان وملح وفلفل","nameEn":null,"standardAmount":"حسب الرغبة"}],"uniqueInstructions":[{"stepNumber":1,"text":"تُجهز الدجاجة وتُتبل داخلها بالملح والفلفل، ويوضع بها الكبد والقونصة وفصان من الحبهان، ثم تُحمر صحيحة في السمن.","textEn":null},{"stepNumber":2,"text":"يُضاف إليها البصلة والكرفس والجزر ولتر ماء، وتُترك على نار متوسطة حتى تنضج.","textEn":null},{"stepNumber":3,"text":"تُرفع الدجاجة وتُقطع 4 قطع ويُنزع العظم من الصدر، وتُترك في مكان دافئ، ثم تُصفى الصلصة المتخلفة لفصل بقايا الخضار.","textEn":null},{"stepNumber":4,"text":"يُقشر البطاطس الصغير ثم يُحمر في قليل من المسلي، ويُضاف إليه الصلصة السابقة المصفاة ويُترك على النار نحو 10 دقائق حتى ينضج البطاطس.","textEn":null},{"stepNumber":5,"text":"تُرص قطع الدجاجة في صحن دافئ وحولها البطاطس، ثم تُصب الصلصة فوقها.","textEn":null}]},"estimate":{"servings":4,"kcal":360,"protein":36,"fat":16,"carbs":14,"fiber":2,"sugar":0},"allergens":{"contains":["milk","celery"],"status":"contains","ruleset":"fifi-allergen-1"},"gluten":{"status":"free","ruleset":"fifi-allergen-1","basis":"ingredients"},"lactose":{"status":"low_or_possible","ruleset":"fifi-lactose-1","basis":"ingredients"},"trimmed":true}